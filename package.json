{
  "name": "www.spencerwill.com",
  "version": "0.0.0",
  "description": "Spencer Will's personal site",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Spencer Will",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "lint-staged": "^17.3.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "generate-routes": "pnpm --filter web generate-routes",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @spencerwill/infra typecheck",
    "infra:preview": "pulumi preview --cwd infra --stack prod",
    "infra:up": "pulumi up --cwd infra --stack prod",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
