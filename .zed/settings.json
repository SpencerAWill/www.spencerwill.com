// Editor settings for this repo. Kept at the workspace root rather than inside
// apps/web so it still applies once other packages land alongside it.
{
  "format_on_save": "on",

  // Biome is the whole toolchain here (lint + format + import sorting), so every
  // language it owns is pointed at its language server explicitly. Zed picks up
  // biome.json from apps/web automatically; `require_config_file` keeps it from
  // silently formatting with built-in defaults anywhere a config is missing.
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },

  "languages": {
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } }
    }
  },

  // routeTree.gen.ts is regenerated by `tsr generate` on every route change.
  // Hiding it keeps the file finder and project search free of a large artifact
  // nobody edits by hand; biome.json already excludes it from lint and format.
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.DS_Store",
    "**/src/routeTree.gen.ts"
  ]
}
